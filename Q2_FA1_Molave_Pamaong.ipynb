      "source": [
        "#the functions for the operations.\n"
        "#function for addition, adding num1 and num2\n",
        "def add(num1,num2):\n",
        " return num1 + num2\n",
        "\n",
        "#function for subtraction\n",
        "def subtract(num1,num2):\n",
        " return num1 - num2\n",
        "\n",
        "#function for multiplication\n",
        "def multiply(num1,num2):\n",
        " return num1 * num2\n",
        "\n",
        "#function for division\n",
        "def divide(num1,num2):\n",
        " if num2 == 0:\n",
        "  return \"Error: Cannot divide by zero.\"\n",
        " return num1 / num2\n",
        "\n",
        "#enter the values for number 1 and number 2.\n",
        "num1 = float(input(\"Enter the first number you want: \"))\n",
        "num2 = float(input(\"Enter the second number you want: \"))\n",
        "\n",
        "print(\"\\n1 = Addition\\n2 = Subtraction\\n3 = Multiplication\\n4 = Division\")\n",
        "choice = int(input(\"Choose an operation: \"))\n",
        "\n",
        "#which operation will be used and the result of it\n",
        "if choice == 1:\n",
        " result = add(num1,num2)\n",
        " print(f\"Sum:{result}\")\n",
        "\n",
        "elif choice == 2:\n",
        " result = subtract(num1,num2)\n",
        " print(f\"Difference:{result}\")\n",
        "\n",
        "\n",
        "elif choice == 3:\n",
        " result = multiply(num1,num2)\n",
        " print(f\"Product:{result}\")\n",
        "\n",
        "\n",
        "elif choice == 4:\n",
        " result = divide(num1,num2)\n",
        " print(f\"Quotient:{result}\")"
      ]
